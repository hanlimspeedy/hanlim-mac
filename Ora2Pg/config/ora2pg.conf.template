ORACLE_HOME	__ORACLE_HOME__
ORACLE_DSN	__ORACLE_DSN__
ORACLE_USER	__ORACLE_USER__
ORACLE_PWD	__ORACLE_PWD__

SCHEMA		__ORACLE_SCHEMA__
TYPE		__EXPORT_TYPE__

PG_DSN		__PG_DSN__
PG_USER		__PG_USER__
PG_PWD		__PG_PWD__
PG_VERSION	16

OUTPUT		__OUTPUT_FILE__
EXPORT_SCHEMA	1
CREATE_SCHEMA	1
COMPILE_SCHEMA	0
STOP_ON_ERROR	0
# Emit FKs as DEFERRABLE and have the data load defer them (SET CONSTRAINTS ALL
# DEFERRED) so the single-transaction COPY passes referential checks at COMMIT
# regardless of table load order.
FKEY_DEFERRABLE	1
DEFER_FKEY	1
# Disable user triggers during data load (ALTER TABLE ... DISABLE TRIGGER USER,
# owner-runnable) so audit/autonomous-transaction triggers do not fire on the
# historical COPY — standard bulk-load practice.
DISABLE_TRIGGERS	USER
NLS_LANG	AMERICAN_AMERICA.AL32UTF8
DATA_LIMIT	10000
LONGREADLEN	104857600
JOBS		1
# Parallel Oracle read connections — overlaps round-trips to the slow remote
# Oracle, which otherwise bottlenecks data export (esp. LOB columns).
ORACLE_COPIES	4
DEBUG		0
