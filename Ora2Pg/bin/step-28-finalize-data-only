#!/usr/bin/env bash
# Step 28 (data-only) — finalize AFTER data load: reset sequences to MAX(owned col), then
# refresh the developed materialized views (created WITH NO DATA in the schema).
# Reuses the shared AWS data-only SQL (referenced in place). Connects DIRECTLY to the
# data-only DB (not pg-psql, which is bound to .oracle.env PG_DB).
#   step-28-finalize-data-only <pg|ivory>
set -euo pipefail
PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck disable=SC1091
. "$PROJECT_DIR/bin/env.sh"

TARGET="${1:?usage: $(basename "$0") <pg|ivory>}"
case "$TARGET" in pg|ivory) ;; *) echo "usage: $(basename "$0") <pg|ivory>" >&2; exit 64 ;; esac
PG_DATAONLY_DB="${DATAONLY_PG_DB:-sample_pg_dataonly}"
IVY_DATAONLY_DB="${DATAONLY_IVY_DB:-sample_ivory_dataonly}"

do_psql() {
  if [ "$TARGET" = "pg" ]; then
    PGPASSWORD="$PG_APP_PASSWORD" psql -h "$PG_HOST" -p "$PG_PORT" -U "$PG_APP_USER" -d "$PG_DATAONLY_DB" "$@"
  else
    PGPASSWORD="$IVY_PASSWORD" psql -h "$IVY_HOST" -p "$IVY_PORT" -U "$IVY_SUPERUSER" -d "$IVY_DATAONLY_DB" "$@"
  fi
}

DATAONLY_SQL_DIR="$PROJECT_DIR/aws-dms/sql/data-only"
echo ">> resetting sequences (schema=sample) on $TARGET ..."
do_psql -v ON_ERROR_STOP=1 -v schema=sample -f "$PROJECT_DIR/aws-dms/sql/1180_reset-sequences.sql"

echo ">> refreshing materialized views on $TARGET ..."
do_psql -v ON_ERROR_STOP=1 -f "$DATAONLY_SQL_DIR/1190_refresh-developed-materialized-views.sql"

echo "OK: $TARGET finalized (sequences reset + MVs refreshed). Next: bin/step-29-verify-data-only $TARGET"
