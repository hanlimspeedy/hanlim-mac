#!/usr/bin/env bash
set -euo pipefail

PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck disable=SC1091
. "$PROJECT_DIR/bin/env.sh"

# Ora2Pg TYPE=TEST compares object counts and row counts between the Oracle
# source and the PostgreSQL target. Point the PG connection at sample_pg.
export ORA2PG_TYPE=TEST
export PG_DSN="dbi:Pg:dbname=${PG_DB};host=${PG_HOST};port=${PG_PORT}"
export PG_USER="$PG_APP_USER"
export PG_PASSWORD="$PG_APP_PASSWORD"
export ORA2PG_OUT_DIR="$PROJECT_DIR/output"
export ORA2PG_OUTPUT_FILE="test_pg.txt"

"$PROJECT_DIR/bin/ora2pg-run" | tee "$PROJECT_DIR/output/21_validate_pg.txt"
