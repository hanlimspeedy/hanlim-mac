#!/usr/bin/env bash
set -euo pipefail

PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck disable=SC1091
. "$PROJECT_DIR/bin/env.sh"

: "${ORA_SCHEMA:?Set ORA_SCHEMA in .oracle.env}"

TMP_SQL="$(mktemp)"
trap 'rm -f "$TMP_SQL"' EXIT

ORA_SCHEMA="$ORA_SCHEMA" \
perl -0pe 's/__ORA_SCHEMA__/$ENV{ORA_SCHEMA}/g' \
  "$PROJECT_DIR/sql/04_profile_business_schema.sql.template" > "$TMP_SQL"

exec "$PROJECT_DIR/bin/run-remote-sqlplus-sysdba" "$TMP_SQL"
