#!/usr/bin/env bash
set -euo pipefail

PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck disable=SC1091
. "$PROJECT_DIR/bin/env.sh"

# Export all table data once, target-agnostic, as PostgreSQL COPY statements.
# Ora2Pg orders tables by FK dependency so parents load before children.
# Empty PG_DSN => write COPY statements to a file instead of streaming into PG.
OUT_DIR="$PROJECT_DIR/output/export/data"
rm -rf "$OUT_DIR"
mkdir -p "$OUT_DIR"

PG_DSN="" PG_USER="" PG_PASSWORD="" \
ORA2PG_TYPE="COPY" \
ORA2PG_OUT_DIR="$OUT_DIR" \
ORA2PG_OUTPUT_FILE="01_data.sql" \
"$PROJECT_DIR/bin/ora2pg-run"

echo "---"
echo "data files in $OUT_DIR:"
ls -l "$OUT_DIR"
