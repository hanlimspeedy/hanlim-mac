#!/usr/bin/env bash
set -euo pipefail

PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck disable=SC1091
. "$PROJECT_DIR/bin/env.sh"

: "${ORA_USER:?Set ORA_USER in .oracle.env}"
: "${ORA_PASSWORD:?Set ORA_PASSWORD in .oracle.env}"

CONNECT_STRING="${ORA_USER}/${ORA_PASSWORD}@//${ORACLE_HOST}:${ORACLE_PORT}/${ORACLE_SERVICE}"

exec sqlplus -L -s "$CONNECT_STRING" <<'SQL'
set heading off feedback off pages 0 verify off echo off
select name || chr(9) || open_mode from v$database;
select instance_name || chr(9) || status from v$instance;
exit
SQL
