#!/usr/bin/env bash
set -euo pipefail

PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck disable=SC1091
. "$PROJECT_DIR/bin/env.sh"

: "${IVY_PASSWORD:?Set IVY_PASSWORD in .oracle.env}"

# Create or start the IvorySQL container (idempotent).
if docker ps --format '{{.Names}}' | grep -qx "$IVY_CONTAINER"; then
  echo "container $IVY_CONTAINER already running"
elif docker ps -a --format '{{.Names}}' | grep -qx "$IVY_CONTAINER"; then
  echo "starting existing container $IVY_CONTAINER ..."
  docker start "$IVY_CONTAINER"
else
  echo "creating container $IVY_CONTAINER from $IVY_IMAGE ..."
  docker run -d --name "$IVY_CONTAINER" \
    -p "${IVY_PORT}:5432" \
    -e IVORYSQL_PASSWORD="$IVY_PASSWORD" \
    "$IVY_IMAGE"
fi

# Wait until the server accepts connections (image pull on first run may add time).
echo "waiting for IvorySQL to become ready ..."
for i in $(seq 1 120); do
  if docker exec "$IVY_CONTAINER" pg_isready -U "$IVY_SUPERUSER" >/dev/null 2>&1; then
    echo "ready after ${i}s"
    break
  fi
  sleep 1
done

# Verify from the host over TCP (default db == superuser name for this image).
PGPASSWORD="$IVY_PASSWORD" psql -h "$IVY_HOST" -p "$IVY_PORT" -U "$IVY_SUPERUSER" -d "$IVY_SUPERUSER" -tAc "select version();"
echo "OK: IvorySQL container $IVY_CONTAINER reachable on port $IVY_PORT"
