#!/usr/bin/env bash
# Load every *.sql in a directory into a target, continuing past errors so the
# log captures the full compatibility picture (not just the first failure).
# Deliberately NOT 'set -e': a failing file must not stop the run.
set -uo pipefail

PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

TARGET="${1:?usage: load-sql-dir <pg|ivory> <dir> <logfile>}"
DIR="${2:?usage: load-sql-dir <pg|ivory> <dir> <logfile>}"
LOG="${3:?usage: load-sql-dir <pg|ivory> <dir> <logfile>}"

mkdir -p "$(dirname "$LOG")"
: > "$LOG"

total_err=0
shopt -s nullglob
for f in "$DIR"/*.sql; do
  base="$(basename "$f")"
  echo "=== loading $base into $TARGET ===" | tee -a "$LOG"
  out="$("$PROJECT_DIR/bin/pg-psql" "$TARGET" -v ON_ERROR_STOP=0 -f "$f" 2>&1)"
  printf '%s\n' "$out" >> "$LOG"
  errs="$(printf '%s\n' "$out" | grep -cE 'ERROR:|FATAL:')"
  echo "-- errors in $base: $errs" | tee -a "$LOG"
  total_err=$((total_err + errs))
done

echo "=== TOTAL load errors for $TARGET [$DIR]: $total_err ===" | tee -a "$LOG"
[ "$total_err" -eq 0 ] && echo "RESULT: PASS (0 errors)" || echo "RESULT: $total_err error(s) — see $LOG"
