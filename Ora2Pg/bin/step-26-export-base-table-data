#!/usr/bin/env bash
# Step 26 (data-only) — provide the base-table COPY data file for the data-only load.
# Oracle SAMPLE has only base tables (views/MVs/packages carry no row data), so the full
# TYPE=COPY export produced by bin/step-16-export-data (output/export/data/01_data.sql) IS
# exactly the base-table data. REUSE it if present — re-exporting over the slow remote Oracle
# link is wasteful (10+ min/large table). Only export fresh (restricted with -a) if it's missing.
# Output: output/export/data-only/01_data.sql
set -euo pipefail
PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck disable=SC1091
. "$PROJECT_DIR/bin/env.sh"

DATAONLY_SQL_DIR="$PROJECT_DIR/aws-dms/sql/data-only"
SRC="$PROJECT_DIR/output/export/data/01_data.sql"          # full TYPE=COPY export (step-16)
OUT_DIR="$PROJECT_DIR/output/export/data-only"
DST="$OUT_DIR/01_data.sql"
mkdir -p "$OUT_DIR"

if [ -s "$SRC" ]; then
  echo ">> reusing existing full COPY export (SAMPLE = base tables only): $SRC"
  # The full export COPYs orders data into Oracle PARTITION names (p2018..pmax); the
  # hand-developed schema names them orders_p2018... Route those rows into the parent
  # table 'orders' (PostgreSQL routes by order_date), so partition naming need not match.
  # Targeted by the orders column signature (orders is the only partitioned table).
  sed -E 's/^COPY [A-Za-z0-9_."]+ \(order_id,customer_id,emp_id,order_date,/COPY orders (order_id,customer_id,emp_id,order_date,/' "$SRC" > "$DST"
  echo "   (routed $(grep -cE '^COPY orders \(order_id,' "$DST") orders partition block(s) into parent 'orders')"
else
  ALLOW="$(paste -sd, "$DATAONLY_SQL_DIR/base-table-list.txt" | sed 's/,*$//')"
  echo ">> no prior export found — exporting base-table data from Oracle (ALLOW=$ALLOW)."
  echo "   NOTE: this reads over the remote Oracle link and can be SLOW for large tables."
  PG_DSN="" PG_USER="" PG_PASSWORD="" \
  ORA2PG_TYPE="COPY" ORA2PG_OUT_DIR="$OUT_DIR" ORA2PG_OUTPUT_FILE="01_data.sql" \
    "$PROJECT_DIR/bin/ora2pg-run" -a "$ALLOW"
fi

echo "COPY blocks: $(grep -c '^COPY ' "$DST")  ($(ls -lh "$DST" | awk '{print $5}'))"
echo "OK: base-table COPY data ready ($DST). Next: bin/step-27-load-base-table-data <pg|ivory>"
