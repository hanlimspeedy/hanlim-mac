#!/usr/bin/env bash
set -euo pipefail

PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck disable=SC1091
. "$PROJECT_DIR/bin/env.sh"

# Install the native PostgreSQL 16 server (idempotent). Requires sudo.
if dpkg -s postgresql-16 >/dev/null 2>&1; then
  echo "postgresql-16 already installed"
else
  echo "installing postgresql-16 ..."
  sudo apt-get update -qq
  sudo apt-get install -y postgresql-16
fi

# Ensure the default cluster (16/main) is up. Both calls are idempotent.
sudo systemctl enable --now postgresql >/dev/null 2>&1 || true
sudo pg_ctlcluster 16 main start >/dev/null 2>&1 || true

# Verify the server answers via peer auth as the postgres OS user.
echo "---"
sudo -u postgres psql -tAc "select version();"
echo "listening on port: $(sudo -u postgres psql -tAc 'show port;') (expected ${PG_PORT})"
echo "OK: PostgreSQL 16 server is reachable"
