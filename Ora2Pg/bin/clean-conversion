#!/usr/bin/env bash
set -euo pipefail

# Remove ALL conversion artifacts and reset both target databases to an empty
# pre-load state, so the export -> load -> validate -> report pipeline
# (step-15 ~ step-23) can be re-run from scratch — e.g. after the Oracle sample
# data is regenerated. Safe to run repeatedly.
#
# Requires: PostgreSQL running (step-10) and the IvorySQL container up (step-12).
PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck disable=SC1091
. "$PROJECT_DIR/bin/env.sh"

# 1. Wipe generated artifacts. output/ only ever holds generated files and is
#    gitignored, so removing and recreating it is safe.
echo "removing conversion artifacts in output/ ..."
rm -rf "${PROJECT_DIR:?}/output"
mkdir -p "$PROJECT_DIR/output"

# 2. Reset both target databases (drop + recreate empty, UTF8/C + sample role).
echo "resetting PostgreSQL target ($PG_DB) ..."
"$PROJECT_DIR/bin/reset-target" pg
echo "resetting IvorySQL target ($IVY_DB) ..."
"$PROJECT_DIR/bin/reset-target" ivory

echo "---"
echo "OK: conversion artifacts removed and both targets reset (empty)."
echo "Next: bin/step-15-export-schema -> ... -> bin/step-23-compatibility-report"
