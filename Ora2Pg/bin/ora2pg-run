#!/usr/bin/env bash
set -euo pipefail

PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck disable=SC1091
. "$PROJECT_DIR/bin/env.sh"

: "${ORA_USER:?Set ORA_USER in .oracle.env}"
: "${ORA_PASSWORD:?Set ORA_PASSWORD in .oracle.env}"

ORA_SCHEMA="${ORA_SCHEMA:-}"
ORA2PG_TYPE="${ORA2PG_TYPE:-SHOW_REPORT}"
ORA2PG_OUT_DIR="${ORA2PG_OUT_DIR:-$PROJECT_DIR/output}"
ORA2PG_OUTPUT_FILE="${ORA2PG_OUTPUT_FILE:-${ORA2PG_TYPE,,}.sql}"
# Colon-less defaults: an explicitly-empty PG_DSN stays empty so data exports
# (TYPE=COPY/INSERT) write to a file instead of streaming into PostgreSQL.
PG_DSN="${PG_DSN-dbi:Pg:dbname=postgres;host=127.0.0.1;port=5432}"
PG_USER="${PG_USER-postgres}"
PG_PASSWORD="${PG_PASSWORD-}"

mkdir -p "$ORA2PG_OUT_DIR"
TMP_CONF="$(mktemp)"
trap 'rm -f "$TMP_CONF"' EXIT

ORACLE_HOME="$ORACLE_HOME" \
ORACLE_DSN="$ORACLE_DSN_DEFAULT" \
ORACLE_USER="$ORA_USER" \
ORACLE_PWD="$ORA_PASSWORD" \
ORACLE_SCHEMA="$ORA_SCHEMA" \
EXPORT_TYPE="$ORA2PG_TYPE" \
PG_DSN="$PG_DSN" \
PG_USER="$PG_USER" \
PG_PWD="$PG_PASSWORD" \
OUTPUT_FILE="$ORA2PG_OUTPUT_FILE" \
perl -0pe '
  s/__ORACLE_HOME__/$ENV{ORACLE_HOME}/g;
  s/__ORACLE_DSN__/$ENV{ORACLE_DSN}/g;
  s/__ORACLE_USER__/$ENV{ORACLE_USER}/g;
  s/__ORACLE_PWD__/$ENV{ORACLE_PWD}/g;
  s/__ORACLE_SCHEMA__/$ENV{ORACLE_SCHEMA}/g;
  s/__EXPORT_TYPE__/$ENV{EXPORT_TYPE}/g;
  s/__PG_DSN__/$ENV{PG_DSN}/g;
  s/__PG_USER__/$ENV{PG_USER}/g;
  s/__PG_PWD__/$ENV{PG_PWD}/g;
  s/__OUTPUT_FILE__/$ENV{OUTPUT_FILE}/g;
' "$PROJECT_DIR/config/ora2pg.conf.template" > "$TMP_CONF"

exec "$ORA2PG_BIN" -c "$TMP_CONF" -b "$ORA2PG_OUT_DIR" "$@"
