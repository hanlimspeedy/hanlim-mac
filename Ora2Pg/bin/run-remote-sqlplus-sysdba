#!/usr/bin/env bash
set -euo pipefail

PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck disable=SC1091
. "$PROJECT_DIR/bin/env.sh"

if [ "$#" -ne 1 ]; then
  echo "usage: $(basename "$0") <sql-file>" >&2
  exit 64
fi

SQL_FILE="$1"
if [ ! -f "$SQL_FILE" ]; then
  echo "sql file not found: $SQL_FILE" >&2
  exit 66
fi

REMOTE_SQL_DIR="/home/oracle/.ora2pg-tmp"
REMOTE_SQL_FILE="$REMOTE_SQL_DIR/$(basename "$SQL_FILE").$$"
LOCAL_SQL_FILE="$(mktemp)"

cleanup() {
  rm -f "$LOCAL_SQL_FILE"
  ssh root@"$ORACLE_HOST" "rm -f '$REMOTE_SQL_FILE'" >/dev/null 2>&1 || true
}
trap cleanup EXIT

if [ -n "${ORACLE_SYS_CONTAINER:-}" ]; then
  {
    printf 'alter session set container=%s;\n' "$ORACLE_SYS_CONTAINER"
    cat "$SQL_FILE"
  } > "$LOCAL_SQL_FILE"
else
  cp "$SQL_FILE" "$LOCAL_SQL_FILE"
fi

ssh root@"$ORACLE_HOST" "install -d -o oracle -g oinstall -m 700 '$REMOTE_SQL_DIR'"
scp -q "$LOCAL_SQL_FILE" root@"$ORACLE_HOST":"$REMOTE_SQL_FILE"
ssh root@"$ORACLE_HOST" "chown oracle:oinstall '$REMOTE_SQL_FILE' && chmod 600 '$REMOTE_SQL_FILE'"
ssh root@"$ORACLE_HOST" "su - oracle -c 'sqlplus -L / as sysdba @$REMOTE_SQL_FILE'"
