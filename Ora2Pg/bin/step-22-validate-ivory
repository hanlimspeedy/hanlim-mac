#!/usr/bin/env bash
set -euo pipefail

PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck disable=SC1091
. "$PROJECT_DIR/bin/env.sh"

# Same validation against the IvorySQL target (PG wire protocol, port 5433).
export ORA2PG_TYPE=TEST
export PG_DSN="dbi:Pg:dbname=${IVY_DB};host=${IVY_HOST};port=${IVY_PORT}"
export PG_USER="$IVY_SUPERUSER"
export PG_PASSWORD="$IVY_PASSWORD"
export ORA2PG_OUT_DIR="$PROJECT_DIR/output"
export ORA2PG_OUTPUT_FILE="test_ivory.txt"

"$PROJECT_DIR/bin/ora2pg-run" | tee "$PROJECT_DIR/output/22_validate_ivory.txt"
