#!/usr/bin/env bash
set -euo pipefail

PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck disable=SC1091
. "$PROJECT_DIR/bin/env.sh"

# Object types to export, in load order. SAMPLE only has tables (constraints +
# indexes are bundled into the TABLE export). Extend for richer schemas, e.g.
#   SCHEMA_TYPES="TYPE SEQUENCE TABLE VIEW FUNCTION PROCEDURE PACKAGE TRIGGER"
SCHEMA_TYPES="${SCHEMA_TYPES:-TABLE}"

OUT_DIR="$PROJECT_DIR/output/export/schema"
rm -rf "$OUT_DIR"
mkdir -p "$OUT_DIR"

i=1
for t in $SCHEMA_TYPES; do
  num="$(printf '%02d' "$i")"
  echo "=== exporting $t -> ${num}_${t,,}.sql ==="
  ORA2PG_TYPE="$t" \
  ORA2PG_OUT_DIR="$OUT_DIR" \
  ORA2PG_OUTPUT_FILE="${num}_${t,,}.sql" \
  "$PROJECT_DIR/bin/ora2pg-run"
  i=$((i + 1))
done

echo "---"
echo "schema files in $OUT_DIR:"
ls -l "$OUT_DIR"
