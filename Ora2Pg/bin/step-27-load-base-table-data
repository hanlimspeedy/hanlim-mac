#!/usr/bin/env bash
# Step 27 (data-only) — load the base-table COPY file into the data-only target.
# Loads as a SUPERUSER with session_replication_role=replica so the developed schema's
# NON-deferrable FKs (incl. self-referencing employees.manager_id) and audit triggers are
# bypassed during bulk load (same principle as the AWS DMS path). Data is FK-valid from Oracle.
#   step-27-load-base-table-data <pg|ivory>
# (Cannot reuse load-sql-dir: that connects as the app user, which cannot set replica role.)
set -uo pipefail
PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck disable=SC1091
. "$PROJECT_DIR/bin/env.sh"

TARGET="${1:?usage: $(basename "$0") <pg|ivory>}"
COPY_FILE="$PROJECT_DIR/output/export/data-only/01_data.sql"
LOG_DIR="$PROJECT_DIR/output/load"; mkdir -p "$LOG_DIR"
[ -f "$COPY_FILE" ] || { echo "missing $COPY_FILE — run bin/step-26-export-base-table-data first" >&2; exit 1; }

case "$TARGET" in
  pg)
    db="${DATAONLY_PG_DB:-sample_pg_dataonly}"; log="$LOG_DIR/pg-dataonly.log"
    echo ">> loading into $db as superuser (session_replication_role=replica) ..."
    { echo "SET session_replication_role=replica;"; cat "$COPY_FILE"; } \
      | sudo -u postgres psql -v ON_ERROR_STOP=0 -d "$db" > "$log" 2>&1 ;;
  ivory)
    db="${DATAONLY_IVY_DB:-sample_ivory_dataonly}"; log="$LOG_DIR/ivory-dataonly.log"
    echo ">> loading into $db as superuser (session_replication_role=replica) ..."
    { echo "SET session_replication_role=replica;"; cat "$COPY_FILE"; } \
      | PGPASSWORD="$IVY_PASSWORD" psql -h "$IVY_HOST" -p "$IVY_PORT" -U "$IVY_SUPERUSER" \
          -v ON_ERROR_STOP=0 -d "$db" > "$log" 2>&1 ;;
  *) echo "usage: $(basename "$0") <pg|ivory>" >&2; exit 64 ;;
esac

errs="$(grep -cE 'ERROR:|FATAL:' "$log")"
echo "=== load errors for $TARGET: $errs (see $log) ==="
if [ "$errs" -eq 0 ]; then
  echo "RESULT: PASS (0 errors). Next: bin/step-28-finalize-data-only $TARGET"
else
  echo "RESULT: $errs error(s) — see $log" >&2; exit 1
fi
