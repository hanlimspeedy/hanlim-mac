#!/usr/bin/env bash
set -euo pipefail

PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck disable=SC1091
. "$PROJECT_DIR/bin/env.sh"

: "${ORA2PG_DB_USER:?Set ORA2PG_DB_USER in .oracle.env}"
: "${ORA2PG_DB_PASSWORD:?Set ORA2PG_DB_PASSWORD in .oracle.env}"
: "${ORA_SCHEMA:?Set ORA_SCHEMA in .oracle.env}"

TMP_SQL="$(mktemp)"
trap 'rm -f "$TMP_SQL"' EXIT

ORA2PG_DB_USER="$ORA2PG_DB_USER" \
ORA2PG_DB_PASSWORD="$ORA2PG_DB_PASSWORD" \
ORA2PG_SCHEMA="$ORA_SCHEMA" \
perl -0pe '
  s/__ORA2PG_DB_USER__/$ENV{ORA2PG_DB_USER}/g;
  s/__ORA2PG_DB_PASSWORD__/$ENV{ORA2PG_DB_PASSWORD}/g;
  s/__ORA2PG_SCHEMA__/$ENV{ORA2PG_SCHEMA}/g;
' "$PROJECT_DIR/sql/02_create_ora2pg_user.sql.template" > "$TMP_SQL"

exec "$PROJECT_DIR/bin/run-remote-sqlplus-sysdba" "$TMP_SQL"
