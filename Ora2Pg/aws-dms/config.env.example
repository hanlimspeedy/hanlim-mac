# wrtp (aws oracle -> postgresql) migration config. Copy to config.env and fill.
# config.env is gitignored. NO PASSWORDS HERE — those go to Secrets Manager (step 0400).

# --- AWS ---
AWS_REGION=ap-northeast-2
AWS_PROFILE=                       # optional named profile; empty = default credentials
WRTP_PREFIX=wrtp                   # resource name prefix + stack prefix
WRTP_TAG_KEY=Project
WRTP_TAG_VALUE=wrtp                # every stack/resource gets this tag

# --- Oracle source (see AWS_DMS_SETUP.md) ---
ORACLE_PUBLIC_IP=                  # public IP of the on-prem Oracle (port-forwarded 1521)
ORACLE_PORT=1521
ORACLE_SERVICE=ORCLPDB1            # PDB service name (NOT the CDB SID ORCL)
ORACLE_DMS_USER=C##DMS             # data migration source account
ORACLE_SC_USER=C##DMS_SC           # schema conversion account
ORACLE_SCHEMA=SAMPLE               # schema to migrate

# --- On-prem (this work server) public IP, for RDS security-group ingress ---
ONPREM_CIDR=                       # e.g. 203.0.113.10/32  (so you can pg_dump the RDS)

# --- Target RDS for PostgreSQL (temporary; deleted at teardown) ---
RDS_ENGINE_VERSION=16
RDS_INSTANCE_CLASS=db.t3.medium
RDS_ALLOCATED_STORAGE=100
RDS_DB_NAME=appdb
RDS_MASTER_USER=wrtp_admin

# --- S3 bucket for assessment reports / converted SQL (SSE-S3 only) ---
S3_BUCKET=                         # empty = derive wrtp-sc-<account>-<region>
