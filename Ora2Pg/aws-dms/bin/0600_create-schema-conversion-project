#!/usr/bin/env bash
# Step 0600 — create the DMS Schema Conversion instance profile, data providers and project.
set -euo pipefail
# shellcheck disable=SC1091
. "$(dirname "$0")/lib.sh"

: "${ORACLE_PUBLIC_IP:?set ORACLE_PUBLIC_IP in config.env}"
sub1="$(stack_output network PublicSubnet1Id)"
sub2="$(stack_output network PublicSubnet2Id)"
dmssg="$(stack_output network DmsSecurityGroupId)"
bucket="$(stack_output foundation S3BucketName)"
scs3="$(stack_output foundation ScS3RoleArn)"
scsec="$(stack_output foundation ScSecretsRoleArn)"
orascsec="$(stack_output foundation OracleScSecretArn)"
pgsec="$(stack_output foundation PgTargetSecretArn)"
pghost="$(stack_output target-postgresql RdsEndpointAddress)"

deploy_stack schema-conversion "$AWSDMS_DIR/cfn/schema-conversion.yaml" \
  "Subnet1Id=${sub1}" "Subnet2Id=${sub2}" \
  "DmsSecurityGroupId=${dmssg}" \
  "OracleServerName=${ORACLE_PUBLIC_IP}" \
  "OraclePort=${ORACLE_PORT}" \
  "OracleService=${ORACLE_SERVICE}" \
  "PgServerName=${pghost}" \
  "PgPort=5432" \
  "PgDbName=${RDS_DB_NAME}" \
  "S3BucketName=${bucket}" \
  "ScS3RoleArn=${scs3}" \
  "ScSecretsRoleArn=${scsec}" \
  "OracleScSecretArn=${orascsec}" \
  "PgTargetSecretArn=${pgsec}"

echo "--- outputs ---"
aws cloudformation describe-stacks --stack-name "$(stack_name schema-conversion)" \
  --query 'Stacks[0].Outputs' --output table
