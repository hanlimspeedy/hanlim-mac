#!/usr/bin/env bash
# Step 1180 — cut over: stop the CDC task at a caught-up point so the dump is consistent,
# then reset target sequences. REQUIRES that Oracle application writes are ALREADY stopped.
#
#   (no flag)          refuse + explain (safety gate)
#   --source-quiesced  proceed: wait CDC latency ~0, stop task, reset sequences
set -euo pipefail
# shellcheck disable=SC1091
. "$(dirname "$0")/lib.sh"

if [ "${1:-}" != "--source-quiesced" ]; then
  echo "Refusing to cut over without --source-quiesced."
  echo "True cutover = stop Oracle application writes FIRST, then run:"
  echo "  $(basename "$0") --source-quiesced"
  echo "(otherwise changes made after the latency check are lost)."
  exit 2
fi

task="$(stack_output data-migration ReplicationTaskArn)"
ri="$(stack_output data-migration ReplicationInstanceArn)"
riid="$(aws dms describe-replication-instances --filters Name=replication-instance-arn,Values="$ri" \
        --query 'ReplicationInstances[0].ReplicationInstanceIdentifier' --output text 2>/dev/null || echo '')"
tid="$(aws dms describe-replication-tasks --filters Name=replication-task-arn,Values="$task" \
       --query 'ReplicationTasks[0].ReplicationTaskIdentifier' --output text 2>/dev/null || echo '')"

target_latency() {
  local start end
  start="$(date -u -d '-5 min' +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date -u +%Y-%m-%dT%H:%M:%SZ)"
  end="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  aws cloudwatch get-metric-statistics --namespace AWS/DMS --metric-name CDCLatencyTarget \
    --dimensions Name=ReplicationInstanceIdentifier,Value="$riid" Name=ReplicationTaskIdentifier,Value="$tid" \
    --start-time "$start" --end-time "$end" --period 60 --statistics Average \
    --query 'sort_by(Datapoints,&Timestamp)[-1].Average' --output text 2>/dev/null || echo None
}

echo ">> source is quiesced — waiting for CDC to drain (CDCLatencyTarget ~0) ..."
caught=0
for i in $(seq 1 30); do
  lat="$(target_latency)"
  echo "   [$i] CDCLatencyTarget=${lat}s"
  case "$lat" in
    None) : ;;  # no datapoint — fall through to the bounded wait below
    *) awk "BEGIN{exit !($lat <= 2)}" && { caught=$((caught+1)); [ "$caught" -ge 2 ] && { echo "   caught up."; break; }; } || caught=0 ;;
  esac
  sleep 10
done
[ "$caught" -ge 2 ] || echo "   NOTE: did not confirm latency<=2s via CloudWatch; source is quiesced so proceeding to stop."

echo ">> stopping replication task ..."
aws dms stop-replication-task --replication-task-arn "$task" >/dev/null
for i in $(seq 1 30); do
  st="$(aws dms describe-replication-tasks --filters Name=replication-task-arn,Values="$task" \
        --query 'ReplicationTasks[0].Status' --output text 2>/dev/null || echo stopped)"
  echo "   task status: $st"
  [ "$st" = "stopped" ] && break
  sleep 10
done

rds="$(stack_output target-postgresql RdsEndpointAddress)"
pgpw="$(secret_field wrtp-pg-target password)"
tschema="$(printf '%s' "$ORACLE_SCHEMA" | tr 'A-Z' 'a-z')"
echo ">> resetting target sequences (schema=$tschema) ..."
PGPASSWORD="$pgpw" PGSSLMODE=require psql -h "$rds" -U "$RDS_MASTER_USER" -d "$RDS_DB_NAME" \
  -v ON_ERROR_STOP=1 -v schema="$tschema" -f "$AWSDMS_DIR/sql/1180_reset-sequences.sql"

echo "OK: CDC stopped at a consistent point + sequences reset. Next: bin/1200_download-postgresql-dump"
