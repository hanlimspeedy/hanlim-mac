#!/usr/bin/env bash
# Step 9200 — revert the Oracle-side CDC changes made by 0120/0140 (counterpart to 9100).
# 9100 removes only AWS resources; this removes what CDC enable did ON the Oracle database.
#   (no flag)                      DRY-RUN: show current CDC state + what would be reverted
#   --apply                        ONLINE reverts (no restart): revoke CDC grants, drop
#                                  supplemental logging, drop the awsdms_dir_test directory
#   --apply --disable-archivelog   also revert ARCHIVELOG -> NOARCHIVELOG (INSTANCE RESTART)
# NOTE: archive logs already written to the FRA are not auto-deleted (reclaim with RMAN on the host).
set -euo pipefail
# shellcheck disable=SC1091
. "$(dirname "$0")/lib.sh"

APPLY=0; DIS_ARCH=0
for a in "$@"; do case "$a" in
  --apply) APPLY=1 ;; --disable-archivelog) DIS_ARCH=1 ;;
  *) echo "usage: $(basename "$0") [--apply] [--disable-archivelog]" >&2; exit 64 ;;
esac; done

REPO_ROOT="$(cd "$AWSDMS_DIR/.." && pwd)"
runner="$REPO_ROOT/bin/run-remote-sqlplus-sysdba"

# read-only current state
chk="$(mktemp "${TMPDIR:-/tmp}/9200-check.XXXXXX.sql")"
trap 'rm -f "$chk"' EXIT
cat > "$chk" <<'SQL'
SET HEADING OFF FEEDBACK OFF PAGESIZE 0 VERIFY OFF
ALTER SESSION SET CONTAINER = CDB$ROOT;
SELECT 'CDCSTATE:' || log_mode || ':' || supplemental_log_data_min || ':' || supplemental_log_data_pk FROM v$database;
EXIT
SQL
line="$("$runner" "$chk" 2>/dev/null | tr -d '\r' | grep -oE 'CDCSTATE:[^[:space:]]+' | head -1 || true)"
[ -n "$line" ] || { echo "ERROR: could not read Oracle CDC state (check SSH / sqlplus / sysdba)" >&2; exit 1; }
IFS=: read -r _ lm sm sp <<<"$line"
echo "current Oracle state: log_mode=$lm supplemental_min=$sm supplemental_pk=$sp"

if [ "$APPLY" -ne 1 ]; then
  echo "--- DRY-RUN (nothing changed). With --apply this will: ---"
  echo "  * revoke Binary Reader CDC grants + sentinel DML grant from C##DMS"
  echo "  * drop DB-level + per-table supplemental logging"
  echo "  * drop the DMS-created awsdms_dir_test directory"
  if [ "$DIS_ARCH" -eq 1 ]; then
    echo "  * revert ARCHIVELOG -> NOARCHIVELOG  ** INSTANCE RESTART (brief full-CDB downtime) **"
  else
    echo "  * (ARCHIVELOG kept — add --disable-archivelog to revert it; requires a restart)"
  fi
  exit 0
fi

echo ">> reverting online CDC changes (grants, supplemental logging, directory) ..."
"$runner" "$AWSDMS_DIR/sql/revert-cdc-oracle.sql"

if [ "$DIS_ARCH" -eq 1 ]; then
  echo ">> reverting ARCHIVELOG -> NOARCHIVELOG (instance restart) ..."
  "$runner" "$AWSDMS_DIR/02_disable_archivelog.sql"
fi

echo "OK: Oracle CDC changes reverted."
echo "    (Archive logs already in the FRA are not auto-deleted — reclaim with RMAN"
echo "     'delete archivelog all;' on the host if you need the FRA space back.)"
