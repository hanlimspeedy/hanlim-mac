#!/usr/bin/env bash
# Step 1010 — test that the data-only replication instance can reach both endpoints.
set -euo pipefail
# shellcheck disable=SC1091
. "$(dirname "$0")/lib.sh"

ri="$(stack_output data-only-migration ReplicationInstanceArn)"
src="$(stack_output data-only-migration SourceEndpointArn)"
tgt="$(stack_output data-only-migration TargetEndpointArn)"

test_one() {
  echo ">> testing $1 ..."
  aws dms test-connection --replication-instance-arn "$ri" --endpoint-arn "$2" >/dev/null 2>&1 || true
  for _ in $(seq 1 20); do
    st="$(aws dms describe-connections \
          --filters Name=endpoint-arn,Values="$2" Name=replication-instance-arn,Values="$ri" \
          --query 'Connections[0].Status' --output text 2>/dev/null || echo testing)"
    echo "   $1: ${st}"
    case "$st" in
      successful) return 0 ;;
      failed)
        aws dms describe-connections --filters Name=endpoint-arn,Values="$2" \
          --query 'Connections[0].LastFailureMessage' --output text
        return 1
        ;;
    esac
    sleep 10
  done
}

test_one source "$src"
test_one target "$tgt"
echo "OK: both data-only endpoints reachable. Next: bin/1110_run-data-only-full-load-and-validate"
