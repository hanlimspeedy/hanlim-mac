#!/usr/bin/env bash
# Step 9100 — tear down ONLY the resources this project created. DRY-RUN by default.
#   (no args)          preview what would be deleted (deletes nothing)
#   --apply            delete non-RDS stacks (RDS/network are kept unless --delete-rds)
#   --delete-rds       also delete the RDS target stack (DATA LOSS — only after 1200 download)
#   --include-shared   also delete the account-shared dms-vpc-role/cloudwatch role stack
# Stacks are deleted in reverse dependency order. Resources NOT in these stacks are never touched.
set -euo pipefail
# shellcheck disable=SC1091
. "$(dirname "$0")/lib.sh"

APPLY=0; DEL_RDS=0; INC_SHARED=0
for a in "$@"; do case "$a" in
  --apply) APPLY=1 ;; --delete-rds) DEL_RDS=1 ;; --include-shared) INC_SHARED=1 ;;
  *) echo "usage: $(basename "$0") [--apply] [--delete-rds] [--include-shared]" >&2; exit 64 ;;
esac; done

# DMS auto-creates CloudWatch log groups OUTSIDE CloudFormation, so delete-stack leaves
# them behind. Capture the ones tied to THIS run (replication instance + migration project)
# now, before their stacks are deleted, so teardown removes exactly ours (not other DMS use).
RI_LOG=""
if stack_exists data-migration; then
  RI_LOG="dms-tasks-wrtp-dms-ri" # matches ReplicationInstanceIdentifier in data-migration.yaml
fi
DATA_ONLY_RI_LOG=""
if stack_exists data-only-migration; then
  DATA_ONLY_RI_LOG="dms-tasks-wrtp-data-only-dms-ri" # matches ReplicationInstanceIdentifier in data-only-data-migration.yaml
fi
SCT_LOG=""
if stack_exists schema-conversion; then
  _projarn="$(stack_output schema-conversion MigrationProjectArn 2>/dev/null || true)"
  [ -n "${_projarn:-}" ] && [ "$_projarn" != "None" ] && SCT_LOG="dms-tasks-sct-${_projarn##*:}"
fi

delete_log_group() { # <name>
  local g="$1" found; [ -n "$g" ] || return 0
  found="$(aws logs describe-log-groups --log-group-name-prefix "$g" \
            --query "logGroups[?logGroupName=='$g'].logGroupName" --output text 2>/dev/null || true)"
  [ "$found" = "$g" ] || { echo "skip log group $g (not present)"; return 0; }
  echo "--- CloudWatch log group $g : would be deleted ---"
  if [ "$APPLY" -eq 1 ]; then aws logs delete-log-group --log-group-name "$g" && echo "   deleted log group $g"; fi
}

echo "=== wrtp teardown — mode: $([ $APPLY -eq 1 ] && echo APPLY || echo 'DRY-RUN (nothing will be deleted)') ==="
echo "Cross-check — account-wide ${TAG_KEY}=${TAG_VALUE} resources:"
aws resourcegroupstaggingapi get-resources --tag-filters "Key=${TAG_KEY},Values=${TAG_VALUE}" \
  --query 'ResourceTagMappingList[].ResourceARN' --output table || true
echo

empty_bucket() {
  local b
  b="$(stack_output foundation S3BucketName 2>/dev/null || default_bucket)"
  echo "   would empty s3://$b"
  [ "$APPLY" -eq 1 ] || return 0
  aws s3 rm "s3://$b" --recursive || true
  for sel in Versions DeleteMarkers; do
    while :; do
      local json cnt
      json="$(aws s3api list-object-versions --bucket "$b" --max-items 500 \
        --query "{Objects: ${sel}[].{Key:Key,VersionId:VersionId}}" --output json 2>/dev/null || echo '{"Objects":null}')"
      cnt="$(jq '(.Objects//[])|length' <<<"$json")"
      [ "$cnt" -gt 0 ] || break
      aws s3api delete-objects --bucket "$b" --delete "$(jq -c '{Objects:.Objects,Quiet:true}' <<<"$json")" >/dev/null || break
    done
  done
}

stack_has_project_tag() { # <short>
  local short="$1" name tag
  name="$(stack_name "$short")"
  tag="$(aws cloudformation describe-stacks --stack-name "$name" \
    --query "Stacks[0].Tags[?Key=='${TAG_KEY}' && Value=='${TAG_VALUE}'] | length(@)" \
    --output text 2>/dev/null || echo 0)"
  [ "$tag" = "1" ]
}

delete_stack() { # <short> [pre-hook-fn]
  local short="$1" name; name="$(stack_name "$short")"
  if ! stack_exists "$short"; then echo "skip $name (not present)"; return; fi
  if ! stack_has_project_tag "$short"; then
    echo "ERROR: refusing to delete $name because it is not tagged ${TAG_KEY}=${TAG_VALUE}" >&2
    exit 1
  fi
  echo "--- $name : resources that would be deleted ---"
  aws cloudformation list-stack-resources --stack-name "$name" \
    --query 'StackResourceSummaries[].{Type:ResourceType,Physical:PhysicalResourceId}' --output table
  [ -n "${2:-}" ] && "$2"
  if [ "$APPLY" -eq 1 ]; then
    echo "   deleting $name ..."
    aws cloudformation delete-stack --stack-name "$name"
    aws cloudformation wait stack-delete-complete --stack-name "$name" && echo "   deleted $name"
  fi
}

# A running replication task blocks stack deletion — stop it first (apply mode).
# A running replication task blocks stack deletion — stop it first (apply mode).
stop_replication_task_if_running() { # <stack-short>
  local short="$1" t s
  [ "$APPLY" -eq 1 ] || return 0
  stack_exists "$short" || return 0
  t="$(stack_output "$short" ReplicationTaskArn 2>/dev/null || true)"
  if [ -n "$t" ]; then
    s="$(aws dms describe-replication-tasks --filters Name=replication-task-arn,Values="$t" --query 'ReplicationTasks[0].Status' --output text 2>/dev/null || echo)"
    if [ "$s" = "running" ] || [ "$s" = "starting" ]; then
      echo "stopping running replication task for $(stack_name "$short") before delete ..."
      aws dms stop-replication-task --replication-task-arn "$t" >/dev/null 2>&1 || true
      for _ in $(seq 1 40); do s="$(aws dms describe-replication-tasks --filters Name=replication-task-arn,Values="$t" --query 'ReplicationTasks[0].Status' --output text 2>/dev/null)"; echo "  task: $s"; [ "$s" = "stopped" ] && break; sleep 10; done
    fi
  fi
}

stop_replication_task_if_running data-only-migration
stop_replication_task_if_running data-migration

delete_stack data-only-migration
delete_stack data-migration
delete_stack schema-conversion

keep_rds=0
if stack_exists target-postgresql; then
  if [ "$DEL_RDS" -eq 0 ]; then
    keep_rds=1
    echo "--- $(stack_name target-postgresql) : SKIPPED (RDS holds data — pass --delete-rds to remove) ---"
  else
    delete_stack target-postgresql
  fi
fi

delete_stack foundation empty_bucket
if [ "$keep_rds" -eq 1 ]; then
  echo "--- $(stack_name network) : SKIPPED (RDS stack still depends on its subnet/security group) ---"
else
  delete_stack network
fi

if stack_exists shared-dms-roles; then
  if [ "$INC_SHARED" -eq 1 ]; then delete_stack shared-dms-roles
  else echo "--- $(stack_name shared-dms-roles) : SKIPPED (account-shared — pass --include-shared to remove) ---"; fi
fi

# DMS-created CloudWatch log groups for THIS run (not tracked by CloudFormation).
delete_log_group "$DATA_ONLY_RI_LOG"
delete_log_group "$RI_LOG"
delete_log_group "$SCT_LOG"

echo
if [ "$APPLY" -eq 0 ]; then
  echo "DRY-RUN only. To delete: $(basename "$0") --apply [--delete-rds] [--include-shared]"
else
  echo "Apply complete. Verify with bin/9000_list-wrtp-resources (should be empty when fully torn down)."
fi
