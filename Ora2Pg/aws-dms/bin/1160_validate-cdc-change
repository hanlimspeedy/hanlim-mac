#!/usr/bin/env bash
# Step 1160 — prove CDC end-to-end: make a controlled change in Oracle and confirm it
# propagates to the RDS target. Reproducible + self-cleaning. CDC only.
#
# Sentinel = SAMPLE.REGION_DIM (no triggers, PK region_code, no inbound FKs;
# manager_emp_id left NULL to avoid its outbound FK). DML runs as the DMS source
# account C##DMS (NON-SYS -> changes ARE mined; SYS/SYSDBA DML is NOT captured).
# Target rows are checked over psql (DMS lowercases the schema/table).
set -euo pipefail
# shellcheck disable=SC1091
. "$(dirname "$0")/lib.sh"

[ "${MIGRATION_TYPE:-full-load}" = "full-load-and-cdc" ] || {
  echo "MIGRATION_TYPE='${MIGRATION_TYPE:-full-load}' — nothing to validate."; exit 0; }

# Oracle client (instant client + LAN host) from the repo-root env.
REPO_ROOT="$(cd "$AWSDMS_DIR/.." && pwd)"
# shellcheck disable=SC1091
. "$REPO_ROOT/bin/env.sh"

ora_user="$(secret_field wrtp-oracle-dms username)"
ora_pw="$(secret_field wrtp-oracle-dms password)"
ora_conn="${ora_user}/${ora_pw}@//${ORACLE_HOST}:${ORACLE_PORT}/${ORACLE_SERVICE}"

rds="$(stack_output target-postgresql RdsEndpointAddress)"
pgpw="$(secret_field wrtp-pg-target password)"
tschema="$(printf '%s' "$ORACLE_SCHEMA" | tr 'A-Z' 'a-z')"

CODE="ZZCDC"; NAME1="cdc-sentinel-1"; NAME2="cdc-sentinel-2"

ora() { # run a statement as C##DMS and COMMIT; surfaces ORA- errors
  sqlplus -L -s "$ora_conn" <<SQL
SET HEADING OFF FEEDBACK OFF VERIFY OFF
WHENEVER SQLERROR EXIT FAILURE
$1
COMMIT;
EXIT
SQL
}

tgt_name() { # current region_name of the sentinel on the target, or empty
  PGPASSWORD="$pgpw" PGSSLMODE=require psql -h "$rds" -U "$RDS_MASTER_USER" -d "$RDS_DB_NAME" \
    -tAc "SELECT region_name FROM ${tschema}.region_dim WHERE region_code='${CODE}'" 2>/dev/null | head -1
}

wait_for() { # <expected> ("" = expect row absent)
  local want="$1" got
  for i in $(seq 1 30); do
    got="$(tgt_name)"
    [ "$got" = "$want" ] && { echo "   propagated in ~$((i*4))s (region_name='${got:-<absent>}')"; return 0; }
    sleep 4
  done
  echo "   TIMEOUT after ~120s waiting for region_name='${want:-<absent>}' (last='${got:-<absent>}')" >&2
  return 1
}

echo ">> 0) clear any stale sentinel on source ..."
ora "DELETE FROM SAMPLE.REGION_DIM WHERE region_code='${CODE}';" >/dev/null

echo ">> 1) INSERT on Oracle -> expect on RDS ..."
ora "INSERT INTO SAMPLE.REGION_DIM (region_code, region_name, manager_emp_id) VALUES ('${CODE}','${NAME1}',NULL);" >/dev/null
wait_for "$NAME1"

echo ">> 2) UPDATE on Oracle -> expect new value on RDS ..."
ora "UPDATE SAMPLE.REGION_DIM SET region_name='${NAME2}' WHERE region_code='${CODE}';" >/dev/null
wait_for "$NAME2"

echo ">> 3) DELETE on Oracle -> expect gone on RDS ..."
ora "DELETE FROM SAMPLE.REGION_DIM WHERE region_code='${CODE}';" >/dev/null
wait_for ""

echo "OK: CDC verified (INSERT+UPDATE+DELETE propagated). See bin/1150 for latency."
echo "    Cut over with bin/1180_stop-cdc-for-cutover after quiescing the source."
