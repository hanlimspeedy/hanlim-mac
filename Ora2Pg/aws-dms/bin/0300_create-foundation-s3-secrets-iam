#!/usr/bin/env bash
# Step 0300 — create S3 (SSE-S3), Secrets Manager shells, and DMS Schema Conversion IAM roles.
set -euo pipefail
# shellcheck disable=SC1091
. "$(dirname "$0")/lib.sh"

bucket="$(default_bucket)"
echo "S3 bucket: $bucket"
deploy_stack foundation "$AWSDMS_DIR/cfn/foundation.yaml" "S3BucketName=${bucket}"

echo "--- outputs ---"
aws cloudformation describe-stacks --stack-name "$(stack_name foundation)" \
  --query 'Stacks[0].Outputs' --output table
