#!/usr/bin/env bash
# Step 0150 — ensure the account-shared DMS service roles exist.
# dms-vpc-role / dms-cloudwatch-logs-role have FIXED names and may be shared with
# other DMS usage. If both already exist we leave them untouched. If missing we
# create them in stack wrtp-shared-dms-roles (teardown EXCLUDES them by default).
set -euo pipefail
# shellcheck disable=SC1091
. "$(dirname "$0")/lib.sh"

have_role() { aws iam get-role --role-name "$1" >/dev/null 2>&1; }

if have_role dms-vpc-role && have_role dms-cloudwatch-logs-role; then
  echo "OK: dms-vpc-role and dms-cloudwatch-logs-role already exist (not managed by wrtp; left as-is)."
  exit 0
fi

echo "one or both shared DMS roles missing — creating via $(stack_name shared-dms-roles) ..."
deploy_stack shared-dms-roles "$AWSDMS_DIR/cfn/shared-dms-roles.yaml"
echo "NOTE: these roles are ACCOUNT-SHARED. bin/9100 teardown excludes them by default;"
echo "      delete only if you are certain no other DMS workload uses them."
