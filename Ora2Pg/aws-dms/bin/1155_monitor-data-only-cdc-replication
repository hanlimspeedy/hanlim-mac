#!/usr/bin/env bash
# Step 1155 — read-only CDC snapshot for the data-only task.
set -euo pipefail
# shellcheck disable=SC1091
. "$(dirname "$0")/lib.sh"

task="$(stack_output data-only-migration ReplicationTaskArn)"
ri="$(stack_output data-only-migration ReplicationInstanceArn)"

echo "--- data-only task ---"
aws dms describe-replication-tasks --filters Name=replication-task-arn,Values="$task" \
  --query 'ReplicationTasks[0].{Status:Status,Type:MigrationType,FullLoadPct:ReplicationTaskStats.FullLoadProgressPercent,TablesLoaded:ReplicationTaskStats.TablesLoaded}' \
  --output table

echo "--- per-table change counts (CDC: Ins/Upd/Del) ---"
aws dms describe-table-statistics --replication-task-arn "$task" \
  --query 'TableStatistics[].{Table:TableName,FullLoad:FullLoadRows,Ins:Inserts,Upd:Updates,Del:Deletes,State:TableState,Validation:ValidationState}' \
  --output table

echo "--- CDC latency (CloudWatch AWS/DMS, latest ~10 min) ---"
riid="$(aws dms describe-replication-instances --filters Name=replication-instance-arn,Values="$ri" \
        --query 'ReplicationInstances[0].ReplicationInstanceIdentifier' --output text 2>/dev/null || echo '')"
tid="$(aws dms describe-replication-tasks --filters Name=replication-task-arn,Values="$task" \
       --query 'ReplicationTasks[0].ReplicationTaskIdentifier' --output text 2>/dev/null || echo '')"
start="$(date -u -d '-10 min' +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date -u +%Y-%m-%dT%H:%M:%SZ)"
end="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
for m in CDCLatencySource CDCLatencyTarget; do
  v="$(aws cloudwatch get-metric-statistics --namespace AWS/DMS --metric-name "$m" \
        --dimensions Name=ReplicationInstanceIdentifier,Value="$riid" Name=ReplicationTaskIdentifier,Value="$tid" \
        --start-time "$start" --end-time "$end" --period 60 --statistics Average \
        --query 'sort_by(Datapoints,&Timestamp)[-1].Average' --output text 2>/dev/null || echo None)"
  echo "  $m: ${v} sec"
done
echo "(latency None = no datapoint yet; per-table Ins/Upd/Del is the latency-free signal)"
