#!/usr/bin/env bash
# Step 1110 — run data-only full load, then leave CDC ongoing.
# Re-runnable: clears only base tables listed in sql/data-only/base-table-list.txt.
set -euo pipefail
# shellcheck disable=SC1091
. "$(dirname "$0")/lib.sh"

task="$(stack_output data-only-migration ReplicationTaskArn)"
table_list="$AWSDMS_DIR/sql/data-only/base-table-list.txt"
tschema="$(printf '%s' "$ORACLE_SCHEMA" | tr '[:upper:]' '[:lower:]')"

status() {
  aws dms describe-replication-tasks --filters Name=replication-task-arn,Values="$task" \
    --query 'ReplicationTasks[0].Status' --output text
}

stop_until_stable() {
  aws dms stop-replication-task --replication-task-arn "$task" >/dev/null
  stable=0
  for _ in $(seq 1 60); do
    cur="$(status)"
    echo "   task status: $cur"
    if [ "$cur" = "stopped" ]; then
      stable=$((stable + 1))
      [ "$stable" -ge 3 ] && return 0
    else
      stable=0
    fi
    sleep 10
  done
  echo "ERROR: data-only task did not stay stopped" >&2
  exit 1
}

reload_target=0
cur="$(status)"
if [ "$cur" = "running" ]; then
  errored="$(aws dms describe-replication-tasks --filters Name=replication-task-arn,Values="$task" \
    --query 'ReplicationTasks[0].ReplicationTaskStats.TablesErrored' --output text 2>/dev/null || echo 0)"
  if [ "${errored:-0}" = "0" ]; then
    echo "Data-only task is already RUNNING (CDC ongoing). Not truncating/restarting."
    echo "Use bin/1155_monitor-data-only-cdc-replication and bin/1165_validate-data-only-cdc-change."
    exit 0
  fi
  echo "Data-only task is RUNNING with $errored table error(s); stopping before reload ..."
  stop_until_stable
  reload_target=1
fi

rds="$(stack_output target-postgresql RdsEndpointAddress)"
pgpw="$(secret_field wrtp-pg-target password)"
tables="$(awk -v schema="$tschema" 'NF {printf "%s%s.%s", sep, schema, $1; sep=", "}' "$table_list")"

echo ">> truncating data-only base tables in schema '$tschema' ..."
PGPASSWORD="$pgpw" PGSSLMODE=require psql -h "$rds" -U "$RDS_MASTER_USER" -d "$RDS_DB_NAME" \
  -v ON_ERROR_STOP=1 <<SQL
SET session_replication_role=replica;
TRUNCATE TABLE ${tables};
SQL

cur="$(status)"
echo "current task status: $cur"
if [ "$cur" = "ready" ] || [ "$cur" = "stopped" ] || [ "$cur" = "failed" ]; then
  start_type=start-replication
  if [ "$reload_target" -eq 1 ] || [ "$cur" = "stopped" ] || [ "$cur" = "failed" ]; then
    start_type=reload-target
  fi
  echo ">> starting data-only full-load-and-cdc ($start_type) ..."
  aws dms start-replication-task --replication-task-arn "$task" --start-replication-task-type "$start_type" >/dev/null
else
  echo "ERROR: data-only task is '$cur' after clean-table step; cannot start reload" >&2
  exit 1
fi

echo ">> waiting for full-load (CDC continues after this step) ..."
for i in $(seq 1 90); do
  s="$(status)"
  pct="$(aws dms describe-replication-tasks --filters Name=replication-task-arn,Values="$task" \
        --query 'ReplicationTasks[0].ReplicationTaskStats.FullLoadProgressPercent' --output text 2>/dev/null || echo 0)"
  read -r comp err loading <<<"$(aws dms describe-table-statistics --replication-task-arn "$task" \
        --query 'TableStatistics[].TableState' --output text 2>/dev/null | tr '\t' '\n' \
        | awk '{t++} /completed/{c++} /error/{e++} END{print c+0, e+0, (t-c-e)}')"
  errnames="$(aws dms describe-table-statistics --replication-task-arn "$task" \
        --query "TableStatistics[?TableState=='Table error'].TableName" --output text 2>/dev/null)"
  echo "   [$i] status=$s fullload=${pct}% completed=${comp:-0} error=${err:-0} loading=${loading:-0}${errnames:+  ERROR: $errnames}"
  [ "$s" = "failed" ] && { echo "TASK FAILED"; break; }
  { [ "$s" != "starting" ] && [ "$pct" = "100" ] && [ "${loading:-1}" -eq 0 ]; } && { echo ">> full load finished"; break; }
  [ "$s" = "stopped" ] && break
  sleep 15
done

echo "--- table statistics ---"
aws dms describe-table-statistics --replication-task-arn "$task" \
  --query 'TableStatistics[].{Schema:SchemaName,Table:TableName,Rows:FullLoadRows,State:TableState,Validation:ValidationState}' \
  --output table

err_count="$(aws dms describe-table-statistics --replication-task-arn "$task" \
  --query "length(TableStatistics[?TableState=='Table error'])" --output text)"
if [ "$err_count" != "0" ]; then
  echo "ERROR: data-only full-load finished with $err_count table error(s)" >&2
  aws dms describe-table-statistics --replication-task-arn "$task" \
    --query "TableStatistics[?TableState=='Table error'].{Schema:SchemaName,Table:TableName,Rows:FullLoadRows,State:TableState}" \
    --output table >&2
  exit 1
fi

if [ "$(status)" = "failed" ]; then
  echo "ERROR: data-only replication task is in FAILED state" >&2
  aws dms describe-replication-tasks --filters Name=replication-task-arn,Values="$task" \
    --query 'ReplicationTasks[0].StopReason' --output text >&2
  exit 1
fi

echo "OK: data-only full load complete; CDC is ongoing."
echo "Next: bin/1155_monitor-data-only-cdc-replication -> bin/1165_validate-data-only-cdc-change"
