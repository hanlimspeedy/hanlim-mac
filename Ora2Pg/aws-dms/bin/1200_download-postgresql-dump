#!/usr/bin/env bash
# Step 1200 — download the migrated PostgreSQL DB from RDS to a local custom-format dump.
set -euo pipefail
# shellcheck disable=SC1091
. "$(dirname "$0")/lib.sh"

host="$(secret_field wrtp-pg-target host)"
user="$(secret_field wrtp-pg-target username)"
pass="$(secret_field wrtp-pg-target password)"
db="$(secret_field wrtp-pg-target dbname)"
: "${host:?RDS host not set in wrtp-pg-target secret (run 0500)}"

out="$OUTPUT_DIR/${db}.dump"
echo ">> pg_dump $user@$host/$db -> $out"
PGPASSWORD="$pass" PGSSLMODE="require" \
  pg_dump -h "$host" -p 5432 -U "$user" -d "$db" -Fc -b -v -f "$out"

echo "OK: $(ls -lh "$out" | awk '{print $5, $NF}')"
echo "Next (optional): bin/1300_restore-dump-to-onprem-postgresql"
