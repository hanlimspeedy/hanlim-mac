#!/usr/bin/env bash
# Step 0550 — apply the repo-managed PostgreSQL schema for final data-only migration.
# This path skips DMS Schema Conversion: PostgreSQL-developed objects come from
# sql/data-only/schema/*.sql, and DMS later loads base table rows only.
set -euo pipefail
# shellcheck disable=SC1091
. "$(dirname "$0")/lib.sh"

rds="$(stack_output target-postgresql RdsEndpointAddress)"
pgpw="$(secret_field wrtp-pg-target password)"
schema_dir="$AWSDMS_DIR/sql/data-only/schema"
table_list="$AWSDMS_DIR/sql/data-only/base-table-list.txt"
tschema="$(printf '%s' "$ORACLE_SCHEMA" | tr '[:upper:]' '[:lower:]')"

echo ">> applying PostgreSQL-developed schema SQL from $schema_dir ..."
found=0
for sql in "$schema_dir"/*.sql; do
  [ -e "$sql" ] || continue
  found=1
  echo "   $(basename "$sql")"
  PGPASSWORD="$pgpw" PGSSLMODE=require psql -h "$rds" -U "$RDS_MASTER_USER" -d "$RDS_DB_NAME" \
    -v ON_ERROR_STOP=1 -f "$sql"
done

if [ "$found" -eq 0 ]; then
  echo "ERROR: no SQL files found in $schema_dir" >&2
  exit 1
fi

echo ">> verifying required base tables exist in schema '$tschema' ..."
missing="$(
  PGPASSWORD="$pgpw" PGSSLMODE=require psql -h "$rds" -U "$RDS_MASTER_USER" -d "$RDS_DB_NAME" \
    -v ON_ERROR_STOP=1 -At <<SQL
WITH required(table_name) AS (
  SELECT trim(line)
  FROM regexp_split_to_table(\$q\$$(grep -v '^[[:space:]]*$' "$table_list")\$q\$, E'\\n') AS t(line)
)
SELECT table_name
FROM required
WHERE to_regclass(format('%I.%I', '${tschema}', table_name)) IS NULL
ORDER BY table_name;
SQL
)"

if [ -n "$missing" ]; then
  echo "ERROR: data-only target schema is missing required base table(s):" >&2
  printf '  %s\n' "$missing" >&2
  echo "Update sql/data-only/schema/*.sql before creating the data-only DMS task." >&2
  exit 1
fi

echo "OK: PostgreSQL-developed schema is ready for data-only load."
echo "Next: bin/0950_create-data-only-full-load-and-cdc-task"
