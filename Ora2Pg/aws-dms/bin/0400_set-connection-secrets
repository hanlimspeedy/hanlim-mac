#!/usr/bin/env bash
# Step 0400 — inject connection credentials into the Secrets Manager shells.
# Passwords are NOT stored in the repo. Oracle passwords follow the documented
# rule (uppercase id reversed); the PG target password is generated here and kept
# only in Secrets Manager. Override any of them via a gitignored secrets.local.env
# (ORACLE_SC_PW / ORACLE_DMS_PW / PG_PW).
set -euo pipefail
# shellcheck disable=SC1091
. "$(dirname "$0")/lib.sh"

: "${ORACLE_PUBLIC_IP:?set ORACLE_PUBLIC_IP in config.env}"
[ -f "$AWSDMS_DIR/secrets.local.env" ] && { set -a; . "$AWSDMS_DIR/secrets.local.env"; set +a; }

ora_sc_pw="${ORACLE_SC_PW:-$(printf '%s' "$ORACLE_SC_USER" | rev)}"
ora_dms_pw="${ORACLE_DMS_PW:-$(printf '%s' "$ORACLE_DMS_USER" | rev)}"
pg_pw="${PG_PW:-$(openssl rand -base64 24 | tr -dc 'A-Za-z0-9' | cut -c1-24)}"

# Persist values locally (gitignored) so re-runs reuse the SAME passwords — keeps
# Secrets Manager, RDS master password and the pg_dump download consistent.
umask 077
cat > "$AWSDMS_DIR/secrets.local.env" <<EOF
# wrtp secret values — DO NOT COMMIT (gitignored). Re-sourced by 0400 on re-run.
ORACLE_SC_PW='${ora_sc_pw}'
ORACLE_DMS_PW='${ora_dms_pw}'
PG_PW='${pg_pw}'
EOF
echo "  saved values to secrets.local.env (gitignored) for reuse"

put() { aws secretsmanager put-secret-value --secret-id "$1" --secret-string "$2" >/dev/null; echo "  set $1"; }

put wrtp-oracle-sc  "$(jq -n --arg u "$ORACLE_SC_USER"  --arg p "$ora_sc_pw"  --arg h "$ORACLE_PUBLIC_IP" --argjson port "$ORACLE_PORT" '{username:$u,password:$p,host:$h,port:$port}')"
put wrtp-oracle-dms "$(jq -n --arg u "$ORACLE_DMS_USER" --arg p "$ora_dms_pw" --arg h "$ORACLE_PUBLIC_IP" --argjson port "$ORACLE_PORT" '{username:$u,password:$p,host:$h,port:$port}')"
# pg-target: host added by step 0500 after RDS exists.
put wrtp-pg-target  "$(jq -n --arg u "$RDS_MASTER_USER" --arg p "$pg_pw" --arg db "$RDS_DB_NAME" '{username:$u,password:$p,port:5432,dbname:$db}')"

echo "OK: secrets populated (values not printed). Next: bin/0500_create-target-postgresql-rds"
