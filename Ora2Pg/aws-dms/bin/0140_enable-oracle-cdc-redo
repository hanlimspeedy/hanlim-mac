#!/usr/bin/env bash
# Step 0140 — enable Oracle redo prerequisites for AWS DMS CDC (Binary Reader):
# ARCHIVELOG mode + supplemental logging. CDC only; self-skips otherwise.
#
# DRY-RUN by default (like 9100): prints current state + FRA/archive usage + the planned
# action, and changes NOTHING. Pass --apply to actually:
#   - run 02_enable_cdc.sql (ARCHIVELOG transition = instance RESTART) IF currently NOARCHIVELOG, and
#   - run 04_supplemental_logging.sql (online, idempotent) always.
# WARNING: ARCHIVELOG archives redo continuously -> confirm FRA headroom + ~24h retention first.
set -euo pipefail
# shellcheck disable=SC1091
. "$(dirname "$0")/lib.sh"

if [ "${MIGRATION_TYPE:-full-load}" != "full-load-and-cdc" ]; then
  echo "MIGRATION_TYPE='${MIGRATION_TYPE:-full-load}' — CDC redo prep not needed. Skipping."
  exit 0
fi

APPLY=0
case "${1:-}" in
  --apply) APPLY=1 ;;
  "")      APPLY=0 ;;
  *) echo "usage: $(basename "$0") [--apply]" >&2; exit 64 ;;
esac

REPO_ROOT="$(cd "$AWSDMS_DIR/.." && pwd)"
runner="$REPO_ROOT/bin/run-remote-sqlplus-sysdba"

# read-only probe: CDC state + FRA usage + active archive destinations (all at CDB$ROOT)
chk="$(mktemp "${TMPDIR:-/tmp}/0140-check.XXXXXX.sql")"
trap 'rm -f "$chk"' EXIT
cat > "$chk" <<'SQL'
SET HEADING OFF FEEDBACK OFF PAGESIZE 0 LINESIZE 200 VERIFY OFF
ALTER SESSION SET CONTAINER = CDB$ROOT;
SELECT 'CDCSTATE:' || log_mode || ':' || supplemental_log_data_min || ':' || supplemental_log_data_pk FROM v$database;
SELECT 'FRA:' || NVL(name, '(FRA not configured)')
       || ' limit_mb='       || NVL(TO_CHAR(ROUND(space_limit/1048576)), '0')
       || ' used_mb='        || NVL(TO_CHAR(ROUND(space_used/1048576)), '0')
       || ' reclaimable_mb=' || NVL(TO_CHAR(ROUND(space_reclaimable/1048576)), '0')
  FROM v$recovery_file_dest;
SELECT 'ARCHDEST:' || dest_name || ' -> ' || destination
  FROM v$archive_dest WHERE destination IS NOT NULL AND status = 'VALID';
EXIT
SQL

probe() { "$runner" "$chk" 2>/dev/null | tr -d '\r'; }

raw="$(probe || true)"
line="$(printf '%s\n' "$raw" | grep -oE 'CDCSTATE:[^[:space:]]+' | head -1 || true)"
[ -n "$line" ] || { echo "ERROR: could not read Oracle CDC state (check SSH / sqlplus / sysdba)" >&2; printf '%s\n' "$raw" >&2; exit 1; }
IFS=: read -r _ log_mode supp_min supp_pk <<<"$line"
echo "current Oracle state: log_mode=$log_mode supplemental_min=$supp_min supplemental_pk=$supp_pk"
printf '%s\n' "$raw" | grep -E '^(FRA|ARCHDEST):' | sed 's/^/  /' || true

restart_needed=0
[ "$log_mode" = "ARCHIVELOG" ] || restart_needed=1

if [ "$APPLY" -ne 1 ]; then
  echo "--- DRY-RUN (nothing changed). Re-run with --apply to perform: ---"
  if [ "$restart_needed" -eq 1 ]; then
    echo "  * 02_enable_cdc.sql            : ARCHIVELOG transition  ** INSTANCE RESTART (brief full-CDB downtime) **"
    echo "    NOTE: confirm FRA headroom (above) + ~24h archive retention BEFORE applying."
  else
    echo "  * (ARCHIVELOG already on — no restart needed)"
  fi
  echo "  * 04_supplemental_logging.sql  : DB-level + per-table supplemental logging (online, idempotent)"
  exit 0
fi

# --- apply ---
if [ "$restart_needed" -eq 1 ]; then
  echo ">> ARCHIVELOG transition (instance restart) ..."
  "$runner" "$AWSDMS_DIR/02_enable_cdc.sql"
else
  echo ">> already ARCHIVELOG — skipping restart."
fi

echo ">> applying supplemental logging (online, idempotent) ..."
"$runner" "$AWSDMS_DIR/04_supplemental_logging.sql"

# --- verify ---
raw="$(probe || true)"
line="$(printf '%s\n' "$raw" | grep -oE 'CDCSTATE:[^[:space:]]+' | head -1 || true)"
IFS=: read -r _ log_mode supp_min supp_pk <<<"$line"
echo "final Oracle state:   log_mode=$log_mode supplemental_min=$supp_min supplemental_pk=$supp_pk"
if [ "$log_mode" = "ARCHIVELOG" ] && [ "$supp_min" != "NO" ] && [ "$supp_pk" != "NO" ]; then
  echo "OK: CDC redo prerequisites satisfied. Next: bin/0900 (rebuild AWS infra first if torn down)."
else
  echo "ERROR: CDC prerequisites not satisfied (need ARCHIVELOG + supplemental min/pk)" >&2
  exit 1
fi
