#!/usr/bin/env bash
# Step 0700 — run the DMS Schema Conversion metadata assessment and pull the report.
# DMS Schema Conversion CLI ops are asynchronous; this starts the assessment, waits
# best-effort, exports the report to the project S3 bucket, and syncs it locally.
# (If the async op is still running, re-run this step — it is idempotent.)
set -euo pipefail
# shellcheck disable=SC1091
. "$(dirname "$0")/lib.sh"

PROJ="wrtp-migration-project"
RULES="$(sc_source_rule)"
bucket="$(stack_output foundation S3BucketName)"

# 1) Import the SOURCE metadata model (required first). Skip if already SUCCESS.
if [ "$(sc_status describe-metadata-model-imports "$PROJ")" = "SUCCESS" ]; then
  echo ">> source metadata model already imported (SUCCESS) — skipping"
else
  echo ">> importing SOURCE metadata model for schema $ORACLE_SCHEMA ..."
  aws dms start-metadata-model-import --migration-project-identifier "$PROJ" \
    --selection-rules "$RULES" --origin SOURCE
  wait_sc describe-metadata-model-imports "$PROJ" || { echo "ERROR: metadata import failed/timeout"; exit 1; }
fi

# 2) Assess conversion difficulty. Skip if already SUCCESS.
if [ "$(sc_status describe-metadata-model-assessments "$PROJ")" = "SUCCESS" ]; then
  echo ">> assessment already done (SUCCESS) — skipping"
else
  echo ">> starting metadata model assessment ..."
  aws dms start-metadata-model-assessment --migration-project-identifier "$PROJ" --selection-rules "$RULES"
  wait_sc describe-metadata-model-assessments "$PROJ" || { echo "ERROR: assessment failed/timeout"; exit 1; }
fi

# 3) Export the assessment report (pdf+csv) to the project S3 bucket.
echo ">> exporting assessment report (pdf+csv) to S3 ..."
aws dms export-metadata-model-assessment --migration-project-identifier "$PROJ" \
  --selection-rules "$RULES" --file-name "wrtp-assessment" --assessment-report-types pdf csv

echo ">> syncing S3 bucket -> output/s3 ..."
mkdir -p "$OUTPUT_DIR/s3"
aws s3 sync "s3://${bucket}" "$OUTPUT_DIR/s3" --delete || true
echo "OK: see $OUTPUT_DIR/s3 for the assessment report. Next: bin/0800_convert-and-apply-schema-to-target"
