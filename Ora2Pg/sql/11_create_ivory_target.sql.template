-- Create the IvorySQL target database (idempotent).
-- Rendered by bin/step-13-create-ivory-target, run as the IvorySQL superuser.
-- Pin UTF8 + C collation to match the PostgreSQL target exactly (the container
-- cluster defaults to SQL_ASCII/C, which would skew the comparison).
SELECT 'CREATE DATABASE __IVY_DB__ TEMPLATE template0 ENCODING ''UTF8'' LC_COLLATE ''C'' LC_CTYPE ''C'''
 WHERE NOT EXISTS (SELECT 1 FROM pg_database WHERE datname = '__IVY_DB__')
\gexec

-- Schema-owner role to match the Ora2Pg export (Oracle owner "sample").
-- The IvorySQL superuser loads the export, so membership is not required here.
SELECT 'CREATE ROLE sample NOLOGIN'
 WHERE NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'sample')
\gexec
